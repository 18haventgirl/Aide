# AI个人日常助手 - 环境变量配置示例
# 复制此文件为 .env 并填写真实的配置值

# OpenAI API 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# 健康知识研究版：与普通助手的模型服务配置完全分离
# 仅 NODE_ENV=development 时启用 source_checked 研究资料
MEDICAL_RESEARCH_MODE=false
MEDICAL_LLM_BASE_URL=https://api.deepseek.com
MEDICAL_LLM_MODEL=deepseek-flash
MEDICAL_LLM_API_KEY=
# 自有兼容服务需要明确设置为 true；默认只接受 DeepSeek/OpenAI 官方或本机地址
MEDICAL_LLM_ALLOW_CUSTOM_HOST=false

# 新闻API配置
NEWS_API_TOKEN=your_news_api_token_here

# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=ai_assistant
DB_CHARSET=utf8mb4

# ChromaDB向量数据库配置
CHROMA_CLIENT_MODE=http
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# 应用配置
NODE_ENV=production
AIDE_ENABLE_LOCAL_TEST_LOGIN=false
