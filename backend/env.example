# AI个人日常助手 - 环境变量配置示例
# 复制此文件为 .env 并填写真实的配置值

# Aide 统一的 OpenAI 兼容模型配置（所有 Agent 共用）
OPENAI_API_KEY=your_provider_api_key_here
OPENAI_API_BASE_URL=https://api.deepseek.com
OPENAI_CHAT_MODEL=deepseek-chat
# 普通笔记向量搜索如使用远程 embedding，请填写该服务真正支持的模型名。
# 医疗 RAG 不读取此项，固定使用本机 BGE。
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 仅 NODE_ENV=development 时启用 source_checked 研究资料
MEDICAL_RESEARCH_MODE=false
MEDICAL_USE_RERANKER=true
MEDICAL_DENSE_CANDIDATES=24
MEDICAL_LEXICAL_CANDIDATES=24
MEDICAL_RERANK_CANDIDATES=8
MEDICAL_RERANK_MIN_SCORE=0.05
MEDICAL_RERANK_RELATIVE_FLOOR=0.35
MEDICAL_MAX_CHUNKS_PER_DOCUMENT=2

# 新闻API配置
NEWS_API_TOKEN=your_news_api_token_here

# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=ai_assistant
DB_CHARSET=utf8mb4

# ChromaDB向量数据库配置
CHROMA_CLIENT_MODE=http
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# 应用配置
NODE_ENV=production
AIDE_ENABLE_LOCAL_TEST_LOGIN=false
