# AI 个人日常助手 — 环境变量示例
# 复制为 backend/.env 后填写真实值。仓库里已忽略 .env，不要提交密钥。

# ============ 大模型 / OpenAI 兼容接口 ============
OPENAI_API_KEY=your_openai_api_key_here
# 兼容网关（Azure / 自建代理 / 本地推理）时改这里
OPENAI_API_BASE_URL=https://api.openai.com/v1
# 编排层是 LangGraph + langchain-openai（走 OpenAI SDK），模型名写本名即可；
# 历史的 litellm 写法 openai/deepseek-chat 会被自动去掉 provider 前缀，两者都可用
OPENAI_CHAT_MODEL=deepseek-chat
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 向量化使用独立密钥时才需要设置，否则回落到 OPENAI_API_KEY
# EMBEDDING_OPENAI_API_KEY=

# ============ 端口与地址 ============
# 后端 API（FastAPI + WebSocket 同端口）
API_HOST=0.0.0.0
API_PORT=8100
# MCP 工具服务，由后端启动为子进程
MCP_HOST=127.0.0.1
MCP_PORT=8102
MCP_PATH=/mcp
# 智能体连接 MCP 的地址；跨机部署时才需要显式覆盖
# MCP_SERVER_URL=http://127.0.0.1:8102/mcp
# 前端开发服务器端口，仅用于生成默认 CORS 白名单
UI_PORT=5199
# 跨域白名单，逗号分隔；不设置时自动放行本机 UI_PORT 与 5173
# CORS_ORIGINS=http://localhost:5199,http://127.0.0.1:5199

# ============ 业务 API（全部免费额度即可） ============
# 新闻：theNewsAPI
NEWS_API_TOKEN=your_news_api_token_here
# 天气（Open-Meteo）与菜谱（TheMealDB）无需密钥

# ============ 关系型数据库（MySQL） ============
# 用 docker-compose 起本地 MySQL 时保持默认即可；库名/账号带 lg_ 前缀，
# 与另一个 Aide 实例的数据完全分开
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=lg_aide
DB_PASSWORD=lg_aide
DB_DATABASE=lg_aide
DB_CHARSET=utf8mb4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ============ 向量化（Embedding） ============
# local: 用工作区内的本地模型算向量，不需要外网和额外密钥（默认）
# openai: 调远端 embeddings API，需要 OPENAI_API_KEY 或 EMBEDDING_OPENAI_API_KEY
EMBEDDING_PROVIDER=local
# 本地模型路径或 HuggingFace 模型名；准备步骤见根目录 README「本地向量化」一节
LOCAL_EMBEDDING_MODEL=./models/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
# 维度必须与模型一致：bge-small-zh-v1.5 是 512，text-embedding-3-small 是 1536
VECTOR_DIMENSION=512

# ============ 向量数据库（ChromaDB） ============
# http: 连接 CHROMA_HOST:CHROMA_PORT 上运行的服务（docker-compose 提供）
# local: 进程内持久化到 CHROMA_PERSIST_DIR，无需外部服务
CHROMA_CLIENT_MODE=http
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8101
CHROMA_PERSIST_DIR=./lg-aide-chroma-db
CHROMA_COLLECTION_PREFIX=lg_aide
# 余弦相似度阈值（0~1）。本地 bge / text-embedding 的相关匹配约 0.45~0.65，调太高会搜不到东西
SIMILARITY_THRESHOLD=0.35
DEFAULT_QUERY_LIMIT=10

# ============ 安全 ============
# JWT 签名密钥。不设置时 core/auth_core/auth.py 会退回到代码内置的默认值，
# 生产环境必须显式改成随机串：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string
